@page "/"
@using Queries
@using UseCases.Commands
@using Web.Dispatchers
@rendermode InteractiveServer
@inherits DispatcherComponent

<PageTitle>Unbeatable Tic Tac Toe</PageTitle>

@if (gameId is null)
{
    <div class="fade-in-up-large center">
        <h1>Unbeatable Tic Tac Toe!</h1>
        <button data-test="start-button" @onclick="StartNewGame">Start!</button>
    </div>
}
else {
    <TicTacToe GameId="gameId.Value" GameCompleted="DisplayResult" />
}

@switch(lastGameResult){
    case ResultDto.Draw:
        <Modal DataTest="draw-modal">
            <span>Draw!</span>
            <button data-test="retry-button" @onclick="StartNewGame">Retry</button>
        </Modal>
        break;
    case ResultDto.WonByPlayerO :
        <Modal DataTest="you-loose-modal">
            <span>You loose!</span>
            <button data-test="retry-button" @onclick="StartNewGame">Retry</button>
        </Modal>
        break;
}

@code {
    private Guid? gameId { get; set; }
    private ResultDto? lastGameResult { get; set; }

    private async Task StartNewGame() {
        this.lastGameResult = null;
        this.gameId = await Dispatch(new StartAGame());
        await StateHasChangedAsync();
    }

    private async Task DisplayResult(ResultDto result)
    {
        lastGameResult = result;
        await StateHasChangedAsync();
    }
}