<div class="modal-position fade-in-up" data-test="@DataTest">
    <MudPaper Elevation="5" Class="surface-glass pa-5">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            @ChildContent
        </MudStack>
    </MudPaper>
</div>
@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; } = default!;
    [Parameter]
    public string DataTest { get; set; } = default!;
}
