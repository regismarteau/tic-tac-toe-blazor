@using Queries
<div class="cell">
    <MudButton Variant="Variant.Text"
               Class="@($"surface-subtle {SymbolClass}")"
               data-test="@($"cell-{Cell}")"
               aria-label="@Label"
               aria-disabled="@(Symbol is not null ? "true" : null)"
               OnClick="Select">
        <span aria-hidden="true">@(Symbol is null ? Empty : Symbol is SymbolDto.Cross ? Cross : Nought)</span>
    </MudButton>
</div>

@code {
    [Parameter]
    public SymbolDto? Symbol { get; set; }
    [Parameter, EditorRequired]
    public CellDto Cell { get; set; }
    [Parameter, EditorRequired] 
    public EventCallback<CellDto> Selected { get; set; }

    private string SymbolClass => Symbol is SymbolDto.Cross ? "text-player" : Symbol is SymbolDto.Nought ? "text-computer" : "";

    private string Label => $"{Cell}: {(Symbol is null ? "empty" : Symbol is SymbolDto.Cross ? "cross" : "nought")}";

    private MarkupString Empty => ((MarkupString)"&nbsp;");

    private MarkupString Cross => ((MarkupString)"&#128940;");

    private MarkupString Nought => ((MarkupString)"&#128902;");

    private async Task Select()
    {
        if(Symbol is null)
        {
            await Selected.InvokeAsync(this.Cell);
        }
    }
}
