@page "/"
@rendermode InteractiveServer
@using Queries
@using UseCases.Commands
@using Web.Shared.DataTests
@inherits Web.Dispatchers.DispatcherComponent

<PageTitle>Unbeatable Tic Tac Toe</PageTitle>

<MudDialogProvider/>

@if (gameId is null)
{
  <MudStack Class="fade-in-up-large" AlignItems="AlignItems.Center" Spacing="4">
    <MudText Typo="Typo.h1" Align="Align.Center">Unbeatable Tic Tac Toe!</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" UserAttributes="TicTacToeDataTests.StartButton"
               OnClick="StartNewGame">Start!
    </MudButton>
  </MudStack>
}
else
{
  <TicTacToe GameId="gameId.Value" GameCompleted="DisplayResult"/>
}

<Modal Visible="isModalVisible" DataTest="modalDataTest" Title="@modalTitle">
  <MudButton Variant="Variant.Filled" Color="Color.Primary" UserAttributes="TicTacToeDataTests.RetryButton"
             OnClick="StartNewGame">Retry
  </MudButton>
</Modal>

@code {
  private Guid? gameId { get; set; }
  private ResultDto? lastGameResult { get; set; }

  private bool isModalVisible => lastGameResult is ResultDto.Draw or ResultDto.WonByPlayerO;
  private string modalTitle => lastGameResult is ResultDto.Draw ? "Draw!" : "You loose!";
  private DataTest modalDataTest => lastGameResult is ResultDto.Draw
    ? TicTacToeDataTests.DrawModal
    : TicTacToeDataTests.YouLooseModal;

  private async Task StartNewGame()
  {
    lastGameResult = null;
    gameId = await Dispatch(new StartAGame());
    await StateHasChangedAsync();
  }

  private async Task DisplayResult(ResultDto result)
  {
    lastGameResult = result;
    await StateHasChangedAsync();
  }
}
